# This file is part of insights-client.
#
# Any changes made to this file will be overwritten during a software update. To
# override a parameter in this file, create a drop-in file, typically located at
# /etc/systemd/system/insights-client.service.d/override.conf. Put the desired
# overrides in that file and reload systemd. The next time this service is run
# (either manually or via a systemd timer), the overridden values will be in
# effect.
#
# For more information about systemd drop-in files, see systemd.unit(5).

[Unit]
Description=Insights Client
Documentation=man:insights-client(8)
After=network.target
StartLimitIntervalSec=12h
StartLimitBurst=6

[Service]
Type=exec
ExecStart=/usr/bin/insights-client
Restart=on-failure
RestartSec=1h
WatchdogSec=900
CPUQuota=30%
MemoryHigh=1G
MemoryMax=2G
TasksMax=300
BlockIOWeight=100

#
# Security
#

User=insights
Group=insights

# Filesystem protection
ProtectHome=read-only
PrivateTmp=yes
ProtectSystem=true
# Cannot be set to "full": /etc/ needs to be writable by insights-client

# Device access
PrivateDevices=yes

# Kernel
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=no
# Cannot be enabled, insights-client client calls selinux.setexeccon() to
# transition child processes into the insights_core_t SELinux domain.

# Process and privilege restrictions
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native

# Capabilities
#
# AmbientCapabilities grants these capabilities into the effective set for the
# non-root user (nobody) at exec time.  CapabilityBoundingSet is the hard
# ceiling — a cap must appear in both to actually be held.  Together they give
# the process the specific privileges it needs without running as uid 0.
AmbientCapabilities=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_SETGID CAP_SETUID CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_RAWIO CAP_SYS_ADMIN CAP_AUDIT_CONTROL CAP_AUDIT_READ
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_SETGID CAP_SETUID CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_RAWIO CAP_SYS_ADMIN CAP_AUDIT_CONTROL CAP_AUDIT_READ
# Dropped:
#   CAP_FSETID, CAP_KILL, CAP_SETPCAP, CAP_LINUX_IMMUTABLE,
#   CAP_NET_BIND_SERVICE, CAP_NET_BROADCAST, CAP_IPC_LOCK, CAP_IPC_OWNER,
#   CAP_SYS_MODULE (also: ProtectKernelModules=yes), CAP_SYS_CHROOT,
#   CAP_SYS_PTRACE, CAP_SYS_PACCT, CAP_SYS_BOOT, CAP_SYS_NICE,
#   CAP_SYS_RESOURCE, CAP_SYS_TIME (also: ProtectClock=yes),
#   CAP_SYS_TTY_CONFIG, CAP_MKNOD, CAP_LEASE, CAP_AUDIT_WRITE,
#   CAP_SETFCAP, CAP_MAC_OVERRIDE, CAP_MAC_ADMIN,
#   CAP_SYSLOG (also: ProtectKernelLogs=yes),
#   CAP_WAKE_ALARM, CAP_BLOCK_SUSPEND, CAP_PERFMON, CAP_BPF,
#   CAP_CHECKPOINT_RESTORE
